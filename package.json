{
  "name": "@liuhange/dsh-clinic-intake",
  "version": "0.1.2",
  "description": "Pre-visit intake structuring for clinics: six patient questions become a structured intake summary (chief complaint, medications, allergies, past history) capped at 300 Chinese characters. Rule-based, local-only, no diagnosis or medication advice. 诊前信息结构化：患者候诊时回答六个问题，自动整理成医生可快速浏览的就诊摘要。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "clinic",
    "intake",
    "triage",
    "chief-complaint",
    "诊所",
    "问诊",
    "主诉",
    "结构化",
    "候诊",
    "medical",
    "patient-intake",
    "就诊摘要",
    "门诊"
  ],
  "homepage": "https://github.com/liuhange789/dsh-clinic-intake#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-clinic-intake.git"
  },
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-clinic-intake/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/extract.test.js test/summary.test.js test/phi.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "author": "liuhange"
}
